#!/usr/bin/env bash
# Vaulty pre-push hook: scan every commit that is about to be pushed.
#
# Git calls this with: $1 = remote name, $2 = remote URL, and one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
#
# If the remote URL matches an entry in .githooks/public-remotes the scan runs in
# strict mode: it fails closed when the confidential terms list or gitleaks is
# missing. Pushes to private remotes get the same scan without strict mode.
set -u

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"
ZERO="0000000000000000000000000000000000000000"

is_public=0
if [ -r "$HOOKS_DIR/public-remotes" ]; then
  while IFS= read -r re; do
    case "$re" in ""|\#*) continue ;; esac
    if printf '%s' "$REMOTE_URL" | grep -qiE -- "$re"; then is_public=1; break; fi
  done < "$HOOKS_DIR/public-remotes"
fi

if [ "$is_public" = 1 ]; then
  export VAULTY_SCAN_STRICT=1
  export VAULTY_SCAN_PUBLIC=1
  printf 'pre-push: remote "%s" is PUBLIC, running strict confidentiality scan\n' "$REMOTE_NAME" >&2
else
  export VAULTY_SCAN_PUBLIC="${VAULTY_SCAN_PUBLIC:-0}"
  printf 'pre-push: remote "%s" is private, running standard scan\n' "$REMOTE_NAME" >&2
fi

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion, nothing to scan

  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: scan everything not already on that remote.
    base=$(git merge-base "$local_sha" "$(git rev-parse --abbrev-ref "$REMOTE_NAME/HEAD" 2>/dev/null || echo "$REMOTE_NAME/main")" 2>/dev/null || true)
    [ -z "$base" ] && base="$ZERO"
  else
    base="$remote_sha"
  fi

  if ! "$HOOKS_DIR/confidentiality-scan.sh" --range "$base" "$local_sha"; then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  printf 'pre-push: push to "%s" refused.\n' "$REMOTE_NAME" >&2
fi
exit $status
