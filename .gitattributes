# Normalise line endings; shell scripts and hooks must stay LF to run in Git Bash, macOS and Linux.
* text=auto
*.sh text eol=lf
.githooks/* text eol=lf
*.cs text
*.razor text
*.json text
*.yml text eol=lf
*.yaml text eol=lf
*.md text
deploy/install/bin/* text eol=lf
*.pl text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.target text eol=lf
*.template text eol=lf
