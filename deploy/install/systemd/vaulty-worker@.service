# Vaulty worker instance %i (Temporal activities). Enable as vaulty-worker@1 ... vaulty-worker@N.
[Unit]
Description=Vaulty Worker %i
PartOf=vaulty.target
After=network-online.target postgresql.service vaulty-migrate.service vaulty-temporal.service
Wants=network-online.target
Requires=vaulty-migrate.service

[Service]
Type=notify
User=vaulty-worker
Group=vaulty
WorkingDirectory=/opt/vaulty/current
ExecStart=/opt/vaulty/current/bin/Vaulty.Workers --instance %i
Environment=VAULTY_CONFIG_DIR=/etc/vaulty
Environment=DOTNET_EnableDiagnostics=0
Environment=DOTNET_gcServer=1

LoadCredentialEncrypted=master-key:/etc/vaulty/credentials/master-key.cred

StateDirectory=vaulty/worker
StateDirectoryMode=0700
LogsDirectory=vaulty
RuntimeDirectory=vaulty-worker-%i
ReadWritePaths=/var/lib/vaulty/staging

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitCORE=0
MemoryDenyWriteExecute=no

MemoryMax={{WORKER_MEMORY_MAX}}
CPUWeight=80

Restart=on-failure
RestartSec=10
TimeoutStartSec=120
# Give a running activity time to finish; Temporal re-queues whatever does not complete.
TimeoutStopSec=600

[Install]
WantedBy=vaulty.target
