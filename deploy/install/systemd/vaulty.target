[Unit]
Description=Vaulty (all services)
Documentation=https://github.com/{{GITHUB_REPO}}
Wants=vaulty-temporal.service vaulty-web.service vaulty-api.service vaulty-gc.service
# Worker instances are added by the installer: vaulty-worker@1.service ... vaulty-worker@N.service
After=network-online.target postgresql.service

[Install]
WantedBy=multi-user.target
