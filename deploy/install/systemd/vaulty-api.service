# Vaulty API. Rendered by the installer; {{...}} placeholders are replaced at install time.
[Unit]
Description=Vaulty API
PartOf=vaulty.target
After=network-online.target postgresql.service vaulty-migrate.service vaulty-temporal.service
Wants=network-online.target
Requires=vaulty-migrate.service

[Service]
Type=notify
User=vaulty-api
Group=vaulty
WorkingDirectory=/opt/vaulty/current
ExecStart=/opt/vaulty/current/bin/Vaulty.Api
Environment=VAULTY_CONFIG_DIR=/etc/vaulty
Environment=ASPNETCORE_URLS=http://127.0.0.1:5001
Environment=DOTNET_EnableDiagnostics=0

# The only secret this unit receives: the host master key, decrypted by systemd into a private ramfs.
LoadCredentialEncrypted=master-key:/etc/vaulty/credentials/master-key.cred

StateDirectory=vaulty/api
StateDirectoryMode=0700
LogsDirectory=vaulty
RuntimeDirectory=vaulty-api
ReadWritePaths=/var/lib/vaulty/staging /var/lib/vaulty/dataprotection

# Hardening
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# A filtered call fails with EPERM instead of killing the process (the .NET runtime probes a few of them).
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitCORE=0
# .NET's JIT needs writable+executable mappings; keep this off until verified with the current runtime.
MemoryDenyWriteExecute=no

MemoryMax={{API_MEMORY_MAX}}
CPUWeight=100

Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=vaulty.target
