@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Vaulty</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeForPage" />
</head>
<body>
    <Routes @rendermode="RenderModeForPage" />
    <script src="_content/MudBlazor/MudBlazor.min.js" nonce="@Nonce"></script>
    <script src="js/passkeys.js" nonce="@Nonce"></script>
    <script src="js/app.js" nonce="@Nonce"></script>
    <script src="_framework/blazor.web.js" nonce="@Nonce"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    private string? Nonce => HttpContext.Items[SecurityHeaders.NonceItemKey] as string;

    /// <summary>Account and setup pages are static (they set cookies); everything else is interactive.</summary>
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext.Request.Path.StartsWithSegments("/account") || HttpContext.Request.Path.StartsWithSegments("/setup")
            ? null
            : InteractiveServer;
}
