<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <PageTitle>Page not found · Vaulty</PageTitle>
            <PageHeader Title="Page not found" />
            <Section>
                <EmptyState Title="This page does not exist" Icon="@Icons.Material.Outlined.SearchOff">
                    <ChildContent>The link may be old, or the item it pointed to has ended with its retention. Search for what you need instead.</ChildContent>
                    <Actions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/">Dashboard</MudButton>
                        <MudButton Variant="Variant.Outlined" Href="/search">Search and restore</MudButton>
                    </Actions>
                </EmptyState>
            </Section>
        </LayoutView>
    </NotFound>
</Router>
