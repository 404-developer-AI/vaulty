@page "/access-denied"
@attribute [Authorize(Policy = VaultyPolicies.SignedIn)]

<PageTitle>Access denied · Vaulty</PageTitle>

<PageHeader Title="You do not have access to this page" />
<Section>
    <EmptyState Title="Your role does not include this page" Icon="@Icons.Material.Outlined.Lock">
        <ChildContent>Ask an organization admin for a role that includes it. Everything you can open is in the menu on the left.</ChildContent>
        <Actions><MudButton Variant="Variant.Outlined" Href="/">Back to the dashboard</MudButton></Actions>
    </EmptyState>
</Section>
