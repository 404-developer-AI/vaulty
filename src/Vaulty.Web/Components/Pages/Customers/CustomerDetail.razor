@page "/customers/{CustomerId:guid}"
@attribute [Authorize(Policy = "perm:" + Permissions.CustomersView)]
@using Vaulty.Core.Domain
@using Vaulty.Infrastructure.Reporting
@using Vaulty.Infrastructure.Tenants
@inject CustomerService CustomerService
@inject TenantService TenantService
@inject DashboardService Dashboards
@inject CurrentAccess Current
@inject DisplayTime Time
@inject NavigationManager Navigation

<PageTitle>@(_customer?.Name ?? "Customer") · Vaulty</PageTitle>

@if (!_loaded)
{
    @* Loading is not "does not exist": the message below only shows once loading found nothing. *@
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_customer is null)
{
    <PageHeader Title="Customer not found" Crumbs="@([new Crumb("Customers", "/customers"), new Crumb("Not found")])" />
    <Section>
        <EmptyState Title="This customer does not exist or you have no access to it" Icon="@Icons.Material.Outlined.SearchOff">
            <Actions><MudButton Variant="Variant.Outlined" Href="/customers">All customers</MudButton></Actions>
        </EmptyState>
    </Section>
}
else
{
    <PageHeader Title="@_customer.Name" Crumbs="@([new Crumb("Customers", "/customers"), new Crumb(_customer.Name)])">
        <Status>
            @if (_status is { } s)
            {
                <StatusChip Status="s.Status" />
            }
        </Status>
        <LedeContent>
            Customer code @_customer.Code
            @foreach (var tag in _customer.Tags)
            {
                <MudChip T="string" Size="Size.Small" Class="ml-2">@tag</MudChip>
            }
        </LedeContent>
        <Actions>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Description" Href="@($"/customers/{CustomerId}/report")">Protection report</MudButton>
            @if (_canConnect)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddLink" Href="@($"/customers/{CustomerId}/connect")">Connect a tenant</MudButton>
            }
        </Actions>
    </PageHeader>

    @if (Added == 1)
    {
        <Notice Tone="success" Title="Customer added">Connect its Microsoft 365 tenant next. It takes about ten minutes, most of it in the tenant itself.</Notice>
    }

    @if (_status is { } st && st.Counts.Count > 0)
    {
        <div class="vy-stats">
            <StatTile Label="Protected" Tone="protected" Value="@StatusText.Number(st.Counts.GetValueOrDefault(ProtectionStatus.Protected))" Caption="Protected objects" />
            <StatTile Label="Failed" Tone="failed" Value="@StatusText.Number(st.Counts.GetValueOrDefault(ProtectionStatus.Failed))" Caption="No current snapshot" />
            <StatTile Label="Partial" Tone="partial" Value="@StatusText.Number(st.Counts.GetValueOrDefault(ProtectionStatus.Partial))" Caption="Snapshot misses items" />
            <StatTile Label="Awaiting first backup" Tone="neutral" Value="@StatusText.Number(st.Counts.GetValueOrDefault(ProtectionStatus.NotRunYet))" Caption="Starts on schedule" />
        </div>
    }

    <Section Title="Tenants" Flush="@(_tenants.Count > 0)">
        @if (_tenants.Count == 0)
        {
            <EmptyState Title="No tenant connected yet" Icon="@Icons.Material.Outlined.Domain">
                <ChildContent>Vaulty creates a certificate and a script; a Global Administrator of the tenant runs it. Then Vaulty checks its permissions and finds the mailboxes and OneDrives.</ChildContent>
                <Actions>
                    @if (_canConnect)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddLink" Href="@($"/customers/{CustomerId}/connect")">Connect a tenant</MudButton>
                    }
                </Actions>
            </EmptyState>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0">
                <thead><tr><th>Tenant</th><th>Status</th><th>Consent</th><th>Protected objects</th><th>Last permission check</th></tr></thead>
                <tbody>
                    @foreach (var t in _tenants)
                    {
                        var status = _status?.Tenants.FirstOrDefault(x => x.Id == t.Id);
                        <tr>
                            <td><a href="@($"/tenants/{t.Id}")" class="vy-cell-main">@t.DisplayName</a><div class="vy-cell-sub">@(t.DefaultDomain ?? t.EntraTenantId.ToString())</div></td>
                            <td>@if (status is not null) { <StatusChip Status="status.Status" Reason="@status.Reason" /> }</td>
                            <td><ConsentChip State="@t.ConsentState" /></td>
                            <td>@(status is null || status.Counts.Count == 0 ? StatusText.Plural(t.ProtectedObjects, "protected object") : Vaulty.Infrastructure.Notifications.DigestMail.Counts(status.Counts))</td>
                            <td class="vy-nowrap">@(t.LastHealthCheckAt is { } at ? Time.Relative(at) : "Never")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </Section>
}

@code {
    [Parameter] public Guid CustomerId { get; set; }
    [SupplyParameterFromQuery(Name = "added")] public int? Added { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private CustomerRow? _customer;
    private CustomerStatusRow? _status;
    private IReadOnlyList<TenantRow> _tenants = [];
    private bool _canConnect;
    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadPageAsync();
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task LoadPageAsync()
    {
        await Time.LoadAsync();
        var user = (await AuthenticationState).User;
        var organizationId = VaultyWebSetup.OrganizationId(user) ?? Guid.Empty;
        var access = await Current.GetAsync(user);
        if (!access.Allows(Permissions.CustomersView, CustomerId)) return;
        _canConnect = access.Allows(Permissions.TenantsConnect, CustomerId);
        _customer = (await CustomerService.ListAsync(organizationId)).FirstOrDefault(c => c.Id == CustomerId);
        _tenants = await TenantService.ListAsync(organizationId, CustomerId);
        _status = (await Dashboards.LoadAsync(access)).Customers.FirstOrDefault(c => c.Id == CustomerId);
    }
}
