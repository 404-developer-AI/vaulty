@page "/error"
@attribute [AllowAnonymous]

<PageTitle>Something went wrong · Vaulty</PageTitle>

<PageHeader Title="Something went wrong" />
<Section>
    <EmptyState Title="This page could not be shown" Icon="@Icons.Material.Outlined.ErrorOutline">
        <ChildContent>Nothing was changed. Try again in a moment; if it keeps happening, the host administrator finds the details in the Vaulty logs.</ChildContent>
        <Actions><a class="vy-button" style="width: auto; text-decoration: none" href="/">Back to the dashboard</a></Actions>
    </EmptyState>
</Section>
