@page "/restores/{RestoreId:guid}"
@attribute [Authorize(Policy = "perm:" + Permissions.SnapshotsBrowse)]
@implements IDisposable
@using Vaulty.Infrastructure.Restore
@using Vaulty.Workflows.Tenants
@inject RestoreService Restores
@inject IWorkflowStarter Workflows
@inject CurrentAccess Current
@inject DisplayTime Time
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@Title · Vaulty</PageTitle>

@if (!_loaded)
{
    @* Loading is not "does not exist": the message below only shows once loading found nothing. *@
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_report is null)
{
    <PageHeader Title="Report not found" Crumbs="@([new Crumb("Jobs", "/jobs"), new Crumb("Not found")])" />
    <Section>
        <EmptyState Title="This restore does not exist, its report has expired, or you have no access to it" Icon="@Icons.Material.Outlined.SearchOff">
            <Actions><MudButton Variant="Variant.Outlined" Href="/jobs?kind=restore">All restores on the Jobs page</MudButton></Actions>
        </EmptyState>
    </Section>
}
else
{
    var r = _report.Restore;
    var c = r.Counts;
    var export = r.Kind == "export";
    <PageHeader Title="@Title" Crumbs="@_crumbs">
        <Status><Chip Tone="@StatusText.JobTone(r.State)" Text="@StatusText.JobLabel(r.State)" /></Status>
        <LedeContent>
            @_report.Object.DisplayName · started @Time.Absolute(r.CreatedAt)@(r.FinishedAt is { } f ? $", finished {Time.Absolute(f)}" : "")
        </LedeContent>
        <Actions>
            @if (_canAct && r.FinishedAt is null && !export)
            {
                @if (r.State == "paused")
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.PlayArrow" OnClick="@(() => SignalAsync("resume"))">Resume</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Pause" OnClick="@(() => SignalAsync("pause"))">Pause</MudButton>
                }
                <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Stop" OnClick="@(() => SignalAsync("cancel"))">Cancel restore</MudButton>
            }
            <MudButton Variant="Variant.Text" Href="@($"/objects/{_report.Object.Id}")">Back to @_report.Object.DisplayName</MudButton>
        </Actions>
    </PageHeader>

    @* What happened and what to do, in one sentence. *@
    <Notice Tone="@OutcomeTone(r.State)" Title="@OutcomeTitle(r.State, export)">@OutcomeText(r.State, export, r.TargetMode)</Notice>

    @if (c is not null)
    {
        var done = c.Total - c.Pending;
        <div class="vy-stats">
            <StatTile Label="@(export ? "Exported" : "Restored")" Tone="protected" Value="@StatusText.Number(c.Restored)" Caption="@($"of {StatusText.Plural(c.Total, "item")}")" />
            <StatTile Label="Skipped" Tone="@(c.Skipped > 0 ? "partial" : null)" Value="@StatusText.Number(c.Skipped)" Caption="Already there or by your choice" />
            <StatTile Label="Failed" Tone="@(c.Failed > 0 ? "failed" : null)" Value="@StatusText.Number(c.Failed)" Caption="Each with its reason below" />
            <StatTile Label="To go" Value="@StatusText.Number(c.Pending)" Caption="@(c.Total > 0 ? $"{(int)(100.0 * done / c.Total)}% done" : "Being planned")" />
        </div>
        @if (r.FinishedAt is null && c.Total > 0)
        {
            <MudProgressLinear Value="@(100.0 * done / c.Total)" Color="Color.Primary" Rounded="true" Size="Size.Medium" Class="mb-5" aria-label="Progress" />
        }
    }

    @if (_report.Export is { } ex)
    {
        <Section Title="Download">
            @if (ex.DownloadedAt is { } downloaded)
            {
                <p class="vy-muted my-0">The export was downloaded @Time.Absolute(downloaded). Links work once; start a new export to download it again.</p>
            }
            else if (ex.ExpiresAt <= Clock.GetUtcNow())
            {
                <p class="vy-muted my-0">The export expired @Time.Absolute(ex.ExpiresAt) without being downloaded. Start a new export from the snapshot.</p>
            }
            else if (_link is not null)
            {
                <p class="mt-0">Your download link works once, until @Time.Absolute(ex.ExpiresAt), and only for you.</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Download" Href="@_link" Target="_self">Download the export (@Vaulty.Web.Browse.ObjectLabels.Size(ex.Size))</MudButton>
            }
            else if (_mine)
            {
                <div class="d-flex flex-wrap align-center gap-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateLinkAsync">Get the download link</MudButton>
                    <span class="vy-muted">@Vaulty.Web.Browse.ObjectLabels.Size(ex.Size), available until @Time.Absolute(ex.ExpiresAt). Asks you to confirm it's you.</span>
                </div>
            }
            else
            {
                <p class="vy-muted my-0">Only the user who asked for this export can download it.</p>
            }
        </Section>
    }

    <Section Title="Items" Flush="true">
        <Actions>
            <div class="vy-seg" role="group" aria-label="Which items to show">
                <button type="button" aria-pressed="@(_onlyProblems ? "false" : "true")" @onclick="@(() => _onlyProblems = false)">All @_report.Items.Count</button>
                <button type="button" aria-pressed="@(_onlyProblems ? "true" : "false")" @onclick="@(() => _onlyProblems = true)">Failed or skipped @_report.Items.Count(i => i.State is "failed" or "skipped")</button>
            </div>
        </Actions>
        <ChildContent>
            <MudTable Items="@(_report.Items.Where(i => !_onlyProblems || i.State is "failed" or "skipped"))" Dense="true" Hover="true" Elevation="0" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                <HeaderContent>
                    <MudTh>Item</MudTh>
                    <MudTh>Folder</MudTh>
                    <MudTh>Result</MudTh>
                    <MudTh>Detail</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@Vaulty.Web.Browse.ObjectLabels.Item(context.Kind)</MudTd>
                    <MudTd>@context.RelativePath</MudTd>
                    <MudTd><span class="vy-status @ItemClass(context.State)">@ItemText(context.State, r.Kind)</span></MudTd>
                    <MudTd>@context.Detail</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <EmptyState Title="@(_onlyProblems ? "No failed or skipped items" : "The items are being planned")" Compact="true" Good="@_onlyProblems"
                                Icon="@(_onlyProblems ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.HourglassEmpty)" />
                </NoRecordsContent>
            </MudTable>
        </ChildContent>
    </Section>
}

@code {
    [Parameter] public Guid RestoreId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private RestoreReport? _report;
    private List<Crumb> _crumbs = [];
    private bool _canAct;
    private bool _mine;
    private bool _onlyProblems;
    private string? _link;
    private Timer? _refresh;

    private string Title => _report?.Restore.Kind == "export" ? "Export" : "Restore";

    private static string OutcomeTone(string state) => state switch
    {
        "succeeded" => "success", "partial" => "warning", "failed" => "error", "cancelled" => "neutral", _ => "info",
    };

    private static string OutcomeTitle(string state, bool export) => (state, export) switch
    {
        ("succeeded", true) => "The export is ready",
        ("succeeded", false) => "Every item is restored",
        ("partial", _) => $"Some items could not be {(export ? "exported" : "restored")}",
        ("failed", _) => $"The {(export ? "export" : "restore")} failed",
        ("cancelled", _) => $"The {(export ? "export" : "restore")} was cancelled",
        ("paused", _) => "The restore is paused",
        _ => $"The {(export ? "export" : "restore")} is running",
    };

    private static string OutcomeText(string state, bool export, string targetMode) => state switch
    {
        "succeeded" when export => "Get the download link below. It works once, within 24 hours.",
        "succeeded" => targetMode switch
        {
            "original" => "The items are back in their original location.",
            _ => "The items are in the folder Vaulty Restore with today's date. Nothing that was there before changed.",
        },
        "partial" => "The items below with Failed have their reason next to them. Fix the cause and restore those items again; the rest is done.",
        "failed" => "The reason is next to each item below. If none is shown, open the job on the Jobs page and quote its request ID to support.",
        "cancelled" => "Items done before the cancellation stay where they are.",
        "paused" => "Nothing more is written until you resume.",
        _ => "This page updates by itself. You can leave it; the restore continues and the report stays here.",
    };

    private static string ItemClass(string state) => state switch { "restored" => "succeeded", "failed" => "failed", "pending" => "running", _ => "neutral" };

    private static string ItemText(string state, string kind) => state switch
    {
        "restored" => kind == "export" ? "Exported" : "Restored", "failed" => "Failed", "skipped" => "Skipped", _ => "Waiting",
    };

    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadPageAsync();
        }
        finally
        {
            _loaded = true;
        }
    }

    private async Task LoadPageAsync()
    {
        await Time.LoadAsync();
        await LoadAsync();
        _refresh ??= new Timer(_ => InvokeAsync(async () =>
        {
            if (_report?.Restore.FinishedAt is not null) return;
            await LoadAsync();
            StateHasChanged();
        }), null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task LoadAsync()
    {
        var access = await Current.GetAsync();
        _report = await Restores.ReportAsync(access, RestoreId);
        if (_report is null) return;
        var o = _report.Object;
        _canAct = access.Allows(Permissions.RestoreInPlace, o.CustomerId) || access.Allows(Permissions.RestoreOtherLocation, o.CustomerId);
        _mine = _report.Export?.CreatedBy == access.UserId;
        _crumbs =
        [
            new("Customers", "/customers"),
            new(o.CustomerName, $"/customers/{o.CustomerId}"),
            new(o.TenantName, $"/tenants/{o.TenantId}"),
            new(o.DisplayName, $"/objects/{o.Id}"),
            new(Title),
        ];
    }

    private async Task SignalAsync(string signal)
    {
        if (signal == "cancel" && !await Dialogs.ConfirmAsync("Cancel this restore?",
                "The restore stops after the items it is working on. Items restored so far stay restored.", "Cancel restore", danger: true, cancelText: "Keep restoring"))
        {
            return;
        }
        await Workflows.SignalRestoreAsync(RestoreId, signal);
        Snackbar.Add(signal switch
        {
            "pause" => "The restore pauses after the items it is working on.",
            "resume" => "The restore continues.",
            _ => "The restore stops after the items it is working on. Items restored so far stay restored.",
        }, Severity.Info);
    }

    private async Task CreateLinkAsync()
    {
        try
        {
            var user = (await AuthenticationState).User;
            var (exportId, token) = await Restores.CreateLinkAsync(await Current.GetAsync(), VaultyWebSetup.HasFreshStepUp(user, Clock), RestoreId);
            _link = $"/exports/{exportId}/download?t={Uri.EscapeDataString(token)}";
        }
        catch (StepUpRequiredException)
        {
            Navigation.NavigateTo($"/account/confirm?returnUrl={Uri.EscapeDataString($"/restores/{RestoreId}")}", forceLoad: true);
        }
        catch (Vaulty.Infrastructure.Access.AccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    public void Dispose() => _refresh?.Dispose();
}
