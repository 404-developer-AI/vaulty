@page "/tenants/{TenantId:guid}"
@attribute [Authorize(Policy = "perm:" + Permissions.CustomersView)]
@using System.Text.Json
@using Vaulty.Graph.Onboarding
@using Vaulty.Infrastructure.Tenants
@using Vaulty.Infrastructure.Retention
@using Vaulty.Workflows.Tenants
@inject TenantService TenantService
@inject TenantDeletion Deletion
@inject LegalHold Holds
@inject IWorkflowStarter Workflows
@inject CurrentAccess Current
@inject NavigationManager Navigation
@inject TimeProvider Clock
@inject ISnackbar Snackbar

<PageTitle>@(_tenant?.DisplayName ?? "Tenant") · Vaulty</PageTitle>

@if (_tenant is null)
{
    <p class="vy-muted">This tenant does not exist or you have no access to it.</p>
}
else
{
    <h1 class="vy-page-title">@_tenant.DisplayName</h1>
    <p class="vy-page-lede">@_tenant.CustomerName · tenant @_tenant.EntraTenantId</p>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudSimpleTable Dense="true" Elevation="0">
            <tbody>
                <tr><td>Consent</td><td><ConsentChip State="@_tenant.ConsentState" /> @HealthDetail</td></tr>
                <tr><td>Application ID</td><td>@_tenant.ClientId</td></tr>
                <tr><td>Certificate valid until</td><td>@_tenant.CertificateExpiresAt?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</td></tr>
                <tr><td>Last check</td><td>@(_tenant.LastHealthCheckAt?.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "never")</td></tr>
            </tbody>
        </MudSimpleTable>
        @if (_canConnect)
        {
            <div class="mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ProbeAsync" Disabled="_busy">Check permissions</MudButton>
                <MudButton Class="ml-2" Variant="Variant.Outlined" OnClick="DiscoverAsync" Disabled="@(_busy || !Granted)">Find mailboxes and OneDrives</MudButton>
                @if (_tenant.NextCertificateExpiresAt is null)
                {
                    <MudButton Class="ml-2" Variant="Variant.Text" OnClick="BeginRotationAsync" Disabled="_busy">Rotate certificate</MudButton>
                }
                else
                {
                    <MudButton Class="ml-2" Variant="Variant.Outlined" OnClick="CompleteRotationAsync" Disabled="_busy">Confirm the new certificate</MudButton>
                }
            </div>
        }
        @if (_report is not null)
        {
            <pre class="vy-secret mt-3">@_report.ToText()</pre>
        }
        @if (_rotationScript is not null)
        {
            <p class="vy-muted mt-3">Run this script in the tenant, then confirm the new certificate. Vaulty switches only after it works.</p>
            <MudTextField T="string" Value="@_rotationScript" ReadOnly="true" Lines="10" Variant="Variant.Outlined" />
        }
    </MudPaper>

    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6">Policy</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_frequencyHours" Label="Back up every (hours)" Min="1" Max="168" Disabled="!_canManagePolicy" /></MudItem>
            <MudItem xs="12" md="3"><MudNumericField @bind-Value="_retentionDays" Label="Retention (days)" Min="90" Disabled="!_canChangeRetention" HelperText="At least 90 days; data is immutable until 30 days after" /></MudItem>
            <MudItem xs="12" md="4"><MudTextField @bind-Value="_excluded" Label="Excluded folders" HelperText="Well-known names, for example junkemail, deleteditems" Disabled="!_canManagePolicy" /></MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-center"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePolicyAsync" Disabled="!_canManagePolicy">Save</MudButton></MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="_objects" Hover="true" Elevation="0" Outlined="true" Dense="true">
        <HeaderContent>
            <MudTh>Protected object</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Last backup</MudTh>
            <MudTh>Legal hold</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @if (_canBrowse)
                {
                    <MudLink Href="@($"/objects/{context.Id}")">@context.DisplayName</MudLink>
                }
                else
                {
                    @context.DisplayName
                }
            </MudTd>
            <MudTd>@KindLabel(context)</MudTd>
            <MudTd>
                @switch (context.State)
                {
                    case "source_deleted":
                        <span class="vy-status neutral">Source deleted @context.SourceDeletedAt?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture)</span>
                        break;
                    case "not_protected":
                        <span class="vy-status neutral">Not protected yet</span>
                        break;
                    case "paused":
                        <span class="vy-status neutral">Paused</span>
                        break;
                    default:
                        <span class="vy-status @(context.LastBackupAt is null ? "neutral" : context.LastSnapshotState == "partial" ? "partial" : "protected")">@(context.LastBackupAt is null ? "Not run yet" : context.LastSnapshotState == "partial" ? "Partial" : "Protected")</span>
                        break;
                }
            </MudTd>
            <MudTd>@(context.LastBackupAt?.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) ?? "")</MudTd>
            <MudTd>
                @if (_canHold)
                {
                    <MudSwitch T="bool" Value="@_held.Contains(context.Id)" ValueChanged="@(v => SetObjectHoldAsync(context, v))" Color="Color.Warning"
                               Disabled="@(_deletion?.LegalHold == true)" aria-label="@($"Legal hold for {context.DisplayName}")" />
                }
                else if (_held.Contains(context.Id))
                {
                    <span class="vy-status neutral">On hold</span>
                }
            </MudTd>
            <MudTd>
                @if (_canRun && context.State == "active" && Granted)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Backup" OnClick="@(() => BackUpNowAsync(context))">Back up now</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent><span class="vy-muted">Nothing found yet. Check permissions, then find mailboxes and OneDrives.</span></NoRecordsContent>
    </MudTable>

    @if (_deletion is not null && (_canHold || _canDelete))
    {
        <MudPaper Class="pa-4 mt-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.h6">Legal hold and deletion</MudText>
            @if (_canHold)
            {
                <MudSwitch T="bool" Value="@_deletion.LegalHold" ValueChanged="SetTenantHoldAsync" Color="Color.Warning"
                           Label="Legal hold for the whole tenant: no snapshot expires until the hold is released" />
            }
            else if (_deletion.LegalHold)
            {
                <p>This tenant is on legal hold: no snapshot expires until the hold is released.</p>
            }
            @if (_canDelete)
            {
                @switch (_deletion.State)
                {
                    case "active":
                        <p class="vy-muted mt-2">Deleting a tenant stops its backups at once. A second administrator can confirm the deletion after 30 days;
                            until then it can be withdrawn. After confirmation the data is removed as its retention lock expires.</p>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RequestDeletionAsync" Disabled="@(_busy || _deletion.LegalHold)">Request deletion</MudButton>
                        break;
                    case "deletion_requested":
                        <MudAlert Severity="Severity.Warning" Class="mt-2">
                            Deletion requested on @_deletion.RequestedAt?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture).
                            Backups are stopped. A second administrator can confirm from @_deletion.ConfirmableFrom?.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture) (UTC).
                        </MudAlert>
                        <div class="mt-2">
                            <MudButton Variant="Variant.Outlined" OnClick="WithdrawDeletionAsync" Disabled="_busy">Withdraw the request</MudButton>
                            @if (_deletion.RequestedBy != _userId)
                            {
                                <MudButton Class="ml-2" Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeletionAsync"
                                           Disabled="@(_busy || Clock.GetUtcNow() < _deletion.ConfirmableFrom)">Confirm deletion</MudButton>
                            }
                        </div>
                        break;
                    default:
                        <p class="mt-2">This tenant is deleted. Its data is removed as its retention lock expires.</p>
                        break;
                }
            }
        </MudPaper>
    }
}

@code {
    [Parameter] public Guid TenantId { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private TenantRow? _tenant;
    private IReadOnlyList<ProtectedObjectRow> _objects = [];
    private PermissionProbeReport? _report;
    private string? _rotationScript;
    private bool _canConnect;
    private bool _canRun;
    private bool _canBrowse;
    private bool _canManagePolicy;
    private bool _canChangeRetention;
    private bool _canHold;
    private bool _canDelete;
    private TenantDeletionState? _deletion;
    private IReadOnlySet<Guid> _held = new HashSet<Guid>();
    private int _frequencyHours = 6;
    private int _retentionDays = 90;
    private string? _excluded;
    private bool _busy;
    private Guid _organizationId;
    private Guid _userId;

    private bool Granted => _tenant?.ConsentState == "granted";

    private string HealthDetail
    {
        get
        {
            try
            {
                using var doc = JsonDocument.Parse(_tenant!.Health);
                return doc.RootElement.TryGetProperty("detail", out var d) ? d.GetString() ?? "" : "";
            }
            catch (JsonException)
            {
                return "";
            }
        }
    }

    private static string KindLabel(ProtectedObjectRow row) => (row.Kind, row.SubKind) switch
    {
        ("mailbox", "shared") => "Shared mailbox",
        ("mailbox", "room" or "equipment") => "Resource mailbox",
        ("mailbox", "archive") => "Archive mailbox",
        ("mailbox", _) => "Mailbox",
        ("drive", _) => "OneDrive",
        _ => row.Kind,
    };

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var user = (await AuthenticationState).User;
        _organizationId = VaultyWebSetup.OrganizationId(user) ?? Guid.Empty;
        _userId = VaultyWebSetup.UserId(user) ?? Guid.Empty;
        var tenant = (await TenantService.ListAsync(_organizationId)).FirstOrDefault(t => t.Id == TenantId);
        var access = await Current.GetAsync(user);
        if (tenant is null || !access.Allows(Permissions.CustomersView, tenant.CustomerId)) return;
        _tenant = tenant;
        _canConnect = access.Allows(Permissions.TenantsConnect, tenant.CustomerId);
        _canRun = access.Allows(Permissions.BackupsRun, tenant.CustomerId);
        _canBrowse = access.Allows(Permissions.SnapshotsBrowse, tenant.CustomerId);
        _canManagePolicy = access.Allows(Permissions.PoliciesManage, tenant.CustomerId);
        _canChangeRetention = access.Allows(Permissions.RetentionManage, tenant.CustomerId);
        _canHold = access.Allows(Permissions.LegalHoldManage, tenant.CustomerId);
        _canDelete = access.Allows(Permissions.TenantsDelete, tenant.CustomerId);
        _objects = await TenantService.ProtectedObjectsAsync(_organizationId, TenantId);
        _deletion = await Deletion.StateAsync(access, TenantId);
        _held = await Holds.ObjectsOnHoldAsync(access, TenantId);
        var policy = await TenantService.PolicyAsync(_organizationId, TenantId);
        (_frequencyHours, _retentionDays, _excluded) = (policy.FrequencyMinutes / 60, policy.RetentionDays, string.Join(", ", policy.ExcludedFolders));
    }

    private async Task<bool> ConfirmedAsync()
    {
        if (VaultyWebSetup.HasFreshStepUp((await AuthenticationState).User, Clock)) return true;
        Navigation.NavigateTo($"/account/confirm?returnUrl={Uri.EscapeDataString($"/tenants/{TenantId}")}", forceLoad: true);
        return false;
    }

    private async Task ProbeAsync()
    {
        _busy = true;
        try
        {
            _report = await TenantService.ProbeAsync(_organizationId, _userId, TenantId);
            if (!_report.BackupReady) Snackbar.Add("Microsoft can take a few minutes before a new app works. Check again shortly.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is Microsoft.Identity.Client.MsalException or InvalidOperationException or HttpRequestException)
        {
            Snackbar.Add($"The app could not sign in yet: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DiscoverAsync()
    {
        _busy = true;
        try
        {
            await Workflows.StartDiscoveryAsync(_organizationId, TenantId, _userId);
            Snackbar.Add("Discovery started. The list fills in when it finishes; follow it on the Jobs page.", Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SavePolicyAsync()
    {
        var current = await TenantService.PolicyAsync(_organizationId, TenantId);
        if (current.RetentionDays != _retentionDays && !_canChangeRetention) return;
        if (current.RetentionDays != _retentionDays && !await ConfirmedAsync()) return;
        try
        {
            await TenantService.SavePolicyAsync(_organizationId, _userId, TenantId, new TenantService.PolicyView(_frequencyHours * 60, _retentionDays,
                (_excluded ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)));
            Snackbar.Add("Policy saved. It applies from the next backup.", Severity.Success);
        }
        catch (TenantException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task SetObjectHoldAsync(ProtectedObjectRow row, bool hold)
    {
        await Holds.SetForObjectAsync(await Current.GetAsync(), row.Id, hold);
        Snackbar.Add(hold ? $"Legal hold placed on {row.DisplayName}." : $"Legal hold on {row.DisplayName} released.", Severity.Info);
        await LoadAsync();
    }

    private async Task SetTenantHoldAsync(bool hold)
    {
        await Holds.SetForTenantAsync(await Current.GetAsync(), TenantId, hold);
        Snackbar.Add(hold ? "Legal hold placed on the tenant." : "Legal hold on the tenant released.", Severity.Info);
        await LoadAsync();
    }

    private async Task RequestDeletionAsync() => await DeletionStepAsync(async (access, fresh) => await Deletion.RequestAsync(access, fresh, TenantId),
        "Deletion requested. Backups are stopped; a second administrator can confirm in 30 days.");

    private async Task WithdrawDeletionAsync() => await DeletionStepAsync(async (access, _) => await Deletion.WithdrawAsync(access, TenantId),
        "The deletion request is withdrawn. Backups resume.");

    private async Task ConfirmDeletionAsync() => await DeletionStepAsync(async (access, fresh) => await Deletion.ConfirmAsync(access, fresh, TenantId),
        "The tenant is deleted.");

    private async Task DeletionStepAsync(Func<Vaulty.Infrastructure.Access.UserAccess, bool, Task> step, string done)
    {
        var user = (await AuthenticationState).User;
        _busy = true;
        try
        {
            await step(await Current.GetAsync(user), VaultyWebSetup.HasFreshStepUp(user, Clock));
            Snackbar.Add(done, Severity.Success);
            await LoadAsync();
        }
        catch (Vaulty.Infrastructure.Restore.StepUpRequiredException)
        {
            await ConfirmedAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or Vaulty.Infrastructure.Access.AccessException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackUpNowAsync(ProtectedObjectRow row)
    {
        var job = await Workflows.StartBackupAsync(_organizationId, TenantId, row.Id, row.Kind, _userId);
        Snackbar.Add(job is null ? "A backup of this object is already running." : "Backup started. Follow it on the Jobs page.", Severity.Info);
    }

    private async Task BeginRotationAsync()
    {
        if (!await ConfirmedAsync()) return;
        _rotationScript = await TenantService.BeginRotationAsync(_organizationId, _userId, TenantId);
        await LoadAsync();
    }

    private async Task CompleteRotationAsync()
    {
        if (!await ConfirmedAsync()) return;
        _busy = true;
        try
        {
            await TenantService.CompleteRotationAsync(_organizationId, _userId, TenantId);
            _rotationScript = null;
            Snackbar.Add("The new certificate works and is now in use. Remove the old certificate from the app registration.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is Microsoft.Identity.Client.MsalException or InvalidOperationException)
        {
            Snackbar.Add($"The new certificate does not work yet: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }
}
