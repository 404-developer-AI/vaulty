@page "/tenants/{TenantId:guid}"
@attribute [Authorize(Policy = "perm:" + Permissions.CustomersView)]
@using System.Text.Json
@using Vaulty.Graph.Onboarding
@using Vaulty.Infrastructure.Tenants
@using Vaulty.Infrastructure.Retention
@using Vaulty.Infrastructure.Reporting
@using Vaulty.Core.Domain
@using Vaulty.Workflows.Tenants
@inject TenantService TenantService
@inject TenantDeletion Deletion
@inject BackupSelection Selection
@inject LegalHold Holds
@inject DashboardService Dashboards
@inject DisplayTime Time
@inject IWorkflowStarter Workflows
@inject CurrentAccess Current
@inject NavigationManager Navigation
@inject Vaulty.Infrastructure.Reporting.ColumnLayoutService ColumnLayouts
@inject TimeProvider Clock
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject SetupAppService SetupApp
@inject BrowserConnection Connection
@inject CertificateRotation Rotation
@inject VaultyHostOptions HostOptions

<PageTitle>@(_tenant?.DisplayName ?? "Tenant") · Vaulty</PageTitle>

@if (!_loaded)
{
    @* Loading is not "does not exist": the message below only shows once loading found nothing. *@
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
}
else if (_tenant is null)
{
    <PageHeader Title="Tenant not found" Crumbs="@([new Crumb("Customers", "/customers"), new Crumb("Not found")])" />
    <Section>
        <EmptyState Title="This tenant does not exist or you have no access to it" Icon="@Icons.Material.Outlined.SearchOff">
            <Actions><MudButton Variant="Variant.Outlined" Href="/customers">All customers</MudButton></Actions>
        </EmptyState>
    </Section>
}
else
{
    <PageHeader Title="@_tenant.DisplayName"
                Crumbs="@([new Crumb("Customers", "/customers"), new Crumb(_tenant.CustomerName, $"/customers/{_tenant.CustomerId}"), new Crumb(_tenant.DisplayName)])">
        <Status>
            @if (_health is { } h)
            {
                <StatusChip Status="h.Status" Reason="@h.Reason" />
            }
            <ConsentChip State="@_tenant.ConsentState" />
            @if (_deletion?.LegalHold == true)
            {
                <span class="vy-tag"><MudIcon Icon="@Icons.Material.Outlined.Gavel" Style="font-size: 14px" /> On legal hold</span>
            }
        </Status>
        <LedeContent>@_tenant.CustomerName · @(_tenant.DefaultDomain is { } d ? $"{d} · " : "")tenant ID <span class="vy-mono">@_tenant.EntraTenantId</span></LedeContent>
        <Actions>
            @if (_canConnect)
            {
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.VerifiedUser" OnClick="ProbeAsync" Disabled="_busy">Check permissions</MudButton>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.TravelExplore" OnClick="DiscoverAsync" Disabled="@(_busy || !Granted)"
                           title="@(Granted ? null : "Check permissions first")">Find mailboxes and OneDrives</MudButton>
            }
        </Actions>
    </PageHeader>

    @if (_tenant.ConsentState == "lost")
    {
        <Notice Tone="error" Title="Vaulty lost access to this tenant; backups cannot run">
            <ChildContent>
                @(string.IsNullOrEmpty(HealthDetail) ? "The app registration was removed, its consent revoked, or its certificate no longer works." : HealthDetail)
                @(_setupReady
                    ? "Repair the connection: an administrator of the tenant signs in, and Vaulty puts back the app, its certificate and its permissions."
                    : "Check permissions to see what is missing. If the app was created again, correct the application ID on the Connection tab.")
            </ChildContent>
            <Actions>
                @if (_canConnect)
                {
                    @if (_setupReady)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="RepairAsync" Disabled="_busy">Repair with Microsoft sign-in</MudButton>
                    }
                    <MudButton Size="Size.Small" Variant="@(_setupReady ? Variant.Outlined : Variant.Filled)" Color="Color.Primary" OnClick="ProbeAsync" Disabled="_busy">Check permissions</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SelectTab(TabConnection))">Open the Connection tab</MudButton>
                }
            </Actions>
        </Notice>
    }
    else if (Connected == 1 || _objects.Count == 0)
    {
        <Notice Tone="info" Title="@(Connected == 1 ? "Tenant connected. Finish the set-up" : "Finish the set-up of this tenant")">
            <ol class="mt-1 mb-0 pl-5">
                <li>@(Granted ? "Permissions checked: done." : "Check permissions. Microsoft can take a few minutes before a new app works; check again if it is not ready.")</li>
                <li>@(_objects.Count > 0 ? $"Mailboxes and OneDrives found: {_objects.Count}." : "Find mailboxes and OneDrives. The list below fills when the discovery job finishes.")</li>
                <li>Choose what is backed up below, and set the backup frequency and retention on the Policy tab.</li>
            </ol>
        </Notice>
    }

    @if (RunQuery is { } run)
    {
        <Section Title="Repair the connection">
            <SetupRunProgress RunId="run" UserId="_userId" OnFinished="RepairFinishedAsync" />
        </Section>
    }

    @if (_report is not null)
    {
        <Notice Tone="@(_report.BackupReady ? "success" : "warning")" Title="@(_report.BackupReady ? "Permissions are in place" : "Some permissions are missing")">
            <ChildContent><pre class="vy-mono mt-2 mb-0" style="white-space: pre-wrap">@_report.ToText()</pre></ChildContent>
            <Actions><MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => _report = null)">Close</MudButton></Actions>
        </Notice>
    }

    @if (_health is { } health)
    {
        <div class="vy-stats">
            <StatTile Label="Protected" Tone="@Protection.CssClass(health.Status)"
                      Value="@($"{StatusText.Number(health.Counts.GetValueOrDefault(ProtectionStatus.Protected))} of {StatusText.Number(health.Counts.Where(c => c.Key != ProtectionStatus.Excluded).Sum(c => c.Value))}")"
                      Caption="@(health.Counts.Count == 0 ? "None yet" : Vaulty.Infrastructure.Notifications.DigestMail.Counts(health.Counts))" />
            <StatTile Label="Oldest latest snapshot" Value="@(health.OldestLatestSnapshotAt is { } oldest ? $"{Protection.Age(Clock.GetUtcNow() - oldest)} ago" : "None yet")"
                      Caption="@(health.OldestLatestSnapshotAt is { } o2 ? Time.Absolute(o2) : "No snapshot yet")" />
            <StatTile Label="Last verification" Value="@(health.LastVerificationAt is { } v ? Time.Relative(v) : "Not run yet")"
                      Caption="@(health.LastVerificationAt is null ? "Runs on schedule" : StatusText.Plural(health.LastVerificationFailures ?? 0, "problem") + " found")"
                      Tone="@(health.LastVerificationFailures is > 0 ? "failed" : null)" />
            <StatTile Label="Microsoft Graph, last 24 hours" Value="@StatusText.Plural(health.Requests24h, "request")"
                      Caption="@($"{StatusText.Number(health.Throttled24h)} throttled (429); throttling is normal and handled")" />
        </div>
    }

    <MudTabs @bind-ActivePanelIndex="_tab" Elevation="0" Rounded="false" ApplyEffectsToContainer="false" Class="vy-tabs" KeepPanelsAlive="false">
        <MudTabPanel Text="@($"Protected objects ({_objects.Count})")">
            <Section Flush="true">
                <div class="vy-table-toolbar" style="padding: 4px 20px 0">
                    <div class="vy-table-search">
                        <MudTextField T="string" @bind-Value="_filterText" Immediate="true" DebounceInterval="200" Placeholder="Search name or e-mail address" Clearable="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" aria-label="Search protected objects" />
                    </div>
                    <div class="vy-table-filter">
                        <MudSelect T="string" @bind-Value="_filterType" Label="Type" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var type in TypeFilters) { <MudSelectItem Value="@type">@type</MudSelectItem> }
                        </MudSelect>
                    </div>
                    <div class="vy-table-filter">
                        <MudSelect T="string" @bind-Value="_filterStatus" Label="Status" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var status in StatusFilters) { <MudSelectItem Value="@status">@status</MudSelectItem> }
                        </MudSelect>
                    </div>
                    <span class="vy-table-count" aria-live="polite">@CountText</span>
                    @if (_canManagePolicy)
                    {
                        <div class="vy-table-toolbar-end">
                            @* The buttons act on the objects shown: filter first, then select or exclude them in one go. *@
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => SetSelectionAsync(Selectable(), true))" Disabled="@(_busy || Selectable().Count == 0)">
                                Back up @Selectable().Count shown
                            </MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => SetSelectionAsync(Selectable(), false))"
                                       Disabled="@(_busy || Selectable().Count == 0)">Exclude @Selectable().Count shown</MudButton>
                        </div>
                    }
                </div>
                <div class="d-flex flex-wrap align-center gap-3" style="padding: 0 20px 8px">
                    <MudSwitch T="bool" Value="@_protectNew" ValueChanged="SetProtectNewAsync" Color="Color.Primary" Disabled="@(!_canManagePolicy || _busy)"
                               Label="Back up newly found mailboxes and OneDrives automatically" />
                    <span class="vy-muted" style="font-size: 0.8125rem">@SelectionSummary</span>
                </div>

                <MudTable Items="Filtered" Hover="true" Elevation="0" Dense="true" T="ProtectedObjectRow" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
                    <HeaderContent>
                        @foreach (var column in _columns)
                        {
                            @switch (column)
                            {
                                case "backup": <MudTh>Back up</MudTh> break;
                                case "object": <MudTh><MudTableSortLabel T="ProtectedObjectRow" SortBy="@(o => o.DisplayName)">Protected object</MudTableSortLabel></MudTh> break;
                                case "type": <MudTh><MudTableSortLabel T="ProtectedObjectRow" SortBy="@(o => KindLabel(o))">Type</MudTableSortLabel></MudTh> break;
                                case "status": <MudTh><MudTableSortLabel T="ProtectedObjectRow" SortBy="@(o => StatusRank(o))" InitialDirection="SortDirection.Descending">Status</MudTableSortLabel></MudTh> break;
                                case "last_backup": <MudTh><MudTableSortLabel T="ProtectedObjectRow" SortBy="@(o => o.LastBackupAt ?? DateTimeOffset.MinValue)">Last backup</MudTableSortLabel></MudTh> break;
                            }
                        }
                        <MudTh><span class="vy-sr-only">Actions</span></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        @foreach (var column in _columns)
                        {
                            @switch (column)
                            {
                                case "backup":
                                <MudTd>
                                    @if (context.State is "active" or "excluded" or "paused")
                                    {
                                        <MudSwitch T="bool" Value="@(context.State != "excluded")" ValueChanged="@(v => SetSelectionAsync([context.Id], v))" Color="Color.Primary"
                                                   Disabled="@(!_canManagePolicy || _busy)" aria-label="@($"Back up {context.DisplayName}")" />
                                    }
                                </MudTd>
                                    break;
                                case "object":
                                <MudTd>
                                    @if (_canBrowse)
                                    {
                                        <a href="@($"/objects/{context.Id}")" class="vy-cell-main">@context.DisplayName</a>
                                    }
                                    else
                                    {
                                        <span class="vy-cell-main">@context.DisplayName</span>
                                    }
                                    @if (Upn(context) is { } upn && !upn.Equals(context.DisplayName, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <div class="vy-cell-sub">@upn</div>
                                    }
                                    @if (_held.Contains(context.Id))
                                    {
                                        <div><span class="vy-tag mt-1"><MudIcon Icon="@Icons.Material.Outlined.Gavel" Style="font-size: 14px" /> On legal hold</span></div>
                                    }
                                </MudTd>
                                    break;
                                case "type":
                                <MudTd>@KindLabel(context)</MudTd>
                                    break;
                                case "status":
                                <MudTd>
                                    @switch (context.State)
                                    {
                                        case "source_deleted":
                                            <span class="vy-status neutral" title="The source no longer exists in Microsoft 365; snapshots are kept until their retention ends.">Source deleted @Time.Absolute(context.SourceDeletedAt)</span>
                                            break;
                                        case "not_protected":
                                            <span class="vy-status neutral">Not protected yet</span>
                                            break;
                                        case "paused":
                                            <span class="vy-status neutral">Paused</span>
                                            break;
                                        case "excluded":
                                            <div class="vy-state">
                                                <span class="vy-status neutral" title="Not selected for backup">Excluded</span>
                                                @if (context.DataRemovedFrom(_retentionDays) is { } removed)
                                                {
                                                    <span class="vy-state-reason" title="Every snapshot ends with its retention; the data goes once its Object Lock has ended. Select it again to keep backing it up.">
                                                        Data removed from @Time.Absolute(removed)
                                                    </span>
                                                }
                                            </div>
                                            break;
                                        default:
                                            @if (_health?.Objects.FirstOrDefault(o => o.Id == context.Id) is { } status)
                                            {
                                                <StatusChip Status="status.Status" Reason="@status.Reason" ShowReason="@(status.Status is ProtectionStatus.Failed)"
                                                            Text="@(status.Status == ProtectionStatus.Partial ? $"Partial: {status.Missing} missing" : null)" />
                                            }
                                            break;
                                    }
                                </MudTd>
                                    break;
                                case "last_backup":
                                <MudTd Class="vy-nowrap">@(context.LastBackupAt is { } at ? Time.Relative(at) : "Never")</MudTd>
                                    break;
                            }
                        }
                        <MudTd Class="vy-actions-cell">
                            @if (_canRun && context.State == "active" && Granted)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Backup" OnClick="@(() => BackUpNowAsync(context))">Back up now</MudButton>
                            }
                            @if (_canHold)
                            {
                                <MudMenu Icon="@Icons.Material.Outlined.MoreVert" Size="Size.Small" AriaLabel="@($"More actions for {context.DisplayName}")" Dense="true">
                                    @if (_held.Contains(context.Id))
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Gavel" OnClick="@(() => SetObjectHoldAsync(context, false))" Disabled="@(_deletion?.LegalHold == true)">Release legal hold</MudMenuItem>
                                    }
                                    else
                                    {
                                        <MudMenuItem Icon="@Icons.Material.Outlined.Gavel" OnClick="@(() => SetObjectHoldAsync(context, true))" Disabled="@(_deletion?.LegalHold == true)">Place on legal hold</MudMenuItem>
                                    }
                                </MudMenu>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        @if (_objects.Count == 0)
                        {
                            <EmptyState Title="No mailboxes or OneDrives found yet" Icon="@Icons.Material.Outlined.Inbox" Compact="true">
                                <ChildContent>@(Granted ? "Find them now; the list fills in when the discovery job finishes." : "Check permissions first, then find the mailboxes and OneDrives.")</ChildContent>
                                <Actions>
                                    @if (_canConnect)
                                    {
                                        @if (Granted)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="DiscoverAsync" Disabled="_busy">Find mailboxes and OneDrives</MudButton>
                                        }
                                        else
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="ProbeAsync" Disabled="_busy">Check permissions</MudButton>
                                        }
                                    }
                                </Actions>
                            </EmptyState>
                        }
                        else
                        {
                            <EmptyState Title="Nothing matches" Icon="@Icons.Material.Outlined.SearchOff" Compact="true">
                                <Actions><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ClearFilters">Clear search and filters</MudButton></Actions>
                            </EmptyState>
                        }
                    </NoRecordsContent>
                </MudTable>
            </Section>
        </MudTabPanel>

        <MudTabPanel Text="Policy">
            <Section Title="Policy for every protected object in this tenant" Description="@PolicyDescription">
                <div class="vy-grid-2" style="max-width: 820px">
                    <MudSelect T="int" @bind-Value="_frequencyHours" Label="Back up" Variant="Variant.Outlined" Disabled="!_canManagePolicy"
                               HelperText="Each backup is incremental: only what changed since the last snapshot is read.">
                        @foreach (var hours in FrequencyOptions)
                        {
                            <MudSelectItem Value="@hours">@FrequencyLabel(hours)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int" @bind-Value="_retentionDays" Label="Retention" Variant="Variant.Outlined" Disabled="!_canChangeRetention"
                               HelperText="@($"Snapshots are kept this long and stored immutably until 30 days after. At least 90 days.{(_canChangeRetention ? "" : " Changing it needs the retention permission.")}")">
                        @foreach (var days in RetentionOptions)
                        {
                            <MudSelectItem Value="@days">@RetentionLabel(days)</MudSelectItem>
                        }
                    </MudSelect>
                    <div style="grid-column: 1 / -1">
                        <MudTextField @bind-Value="_excluded" Label="Excluded folders" Variant="Variant.Outlined" Disabled="!_canManagePolicy"
                                      HelperText="Well-known folder names, separated by commas, for example junkemail, deleteditems" />
                    </div>
                </div>
                <div class="vy-wizard-footer">
                    <span class="vy-grow"></span>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SavePolicyAsync" Disabled="@(!_canManagePolicy || _busy)">Save policy</MudButton>
                </div>
            </Section>
        </MudTabPanel>

        <MudTabPanel Text="Connection">
            <Section Title="App registration" Description="@ConnectionDescription">
                <dl class="vy-fields wide">
                    <dt>Consent</dt><dd><ConsentChip State="@_tenant.ConsentState" /> @HealthDetail</dd>
                    <dt>Last permission check</dt><dd>@(_tenant.LastHealthCheckAt is { } at ? Time.Absolute(at) : "Never")</dd>
                    <dt>Tenant ID</dt><dd class="vy-mono">@_tenant.EntraTenantId</dd>
                    <dt>Application ID</dt><dd class="vy-mono">@_tenant.ClientId</dd>
                    <dt>Certificate valid until</dt>
                    <dd>
                        @Time.Absolute(_tenant.CertificateExpiresAt)
                        @if (_tenant.CertificateExpiresAt is { } exp && exp - Clock.GetUtcNow() < TimeSpan.FromDays(30))
                        {
                            <span class="vy-status partial ml-2">Expires in @Protection.Age(exp - Clock.GetUtcNow())</span>
                        }
                    </dd>
                </dl>
                @if (_canConnect)
                {
                    <div class="vy-wizard-footer">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ProbeAsync" Disabled="_busy">Check permissions</MudButton>
                        @if (_setupReady)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="RepairAsync" Disabled="_busy"
                                       title="An administrator of the tenant signs in; Vaulty puts back the app, its certificate and its permissions">Repair with Microsoft sign-in</MudButton>
                        }
                        @if (_tenant.NextCertificateExpiresAt is null || _tenant.SelfRotation)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="BeginRotationAsync" Disabled="_busy">Rotate certificate</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="CompleteRotationAsync" Disabled="_busy">Confirm the new certificate</MudButton>
                        }
                        <MudButton Variant="Variant.Text" OnClick="ToggleCorrection" Disabled="_busy">Correct tenant ID or application ID</MudButton>
                    </div>
                }
                @if (_canConnect && _setupReady)
                {
                    <MudCheckBox T="bool" @bind-Value="_repairWithRestore" Label="Include restore permissions when repairing" Class="mt-2" />
                }
                <p class="vy-muted mt-2 mb-0" style="font-size: 0.8125rem">
                    @(_tenant.SelfRotation
                        ? "Vaulty renews this certificate itself 60 days before it expires: it adds the new certificate to the app, switches once it works, and removes the old one."
                        : "Vaulty cannot renew this certificate itself yet: rotate it with the script, or repair the connection once with a Microsoft sign-in.")
                </p>
                @if (_rotationScript is not null || (_tenant.NextCertificateExpiresAt is not null && !_tenant.SelfRotation))
                {
                    <Notice Tone="info" Class="mt-4" Title="Certificate rotation started">
                        Run this script in the tenant, then select Confirm the new certificate. Vaulty switches only after the new certificate works.
                    </Notice>
                    @if (_rotationScript is not null)
                    {
                        <pre class="vy-script" tabindex="0" aria-label="Rotation script">@_rotationScript</pre>
                    }
                }
                @if (_correcting)
                {
                    <div class="mt-4" style="max-width: 820px">
                        <div class="vy-grid-2">
                            <MudTextField @bind-Value="_correctTenantId" Label="Tenant ID" Variant="Variant.Outlined" Disabled="@(_deletion?.HoldsBackups == true)"
                                          HelperText="@(_deletion?.HoldsBackups == true ? "Fixed: this tenant holds backups" : "Directory (tenant) ID from Entra")" />
                            <MudTextField @bind-Value="_correctClientId" Label="Application ID" Variant="Variant.Outlined" HelperText="Application ID on the overview of the app registration in Entra" />
                        </div>
                        <p class="vy-muted mt-2 mb-0">The certificate stays the same; the permission check runs again afterwards.</p>
                        <div class="vy-wizard-footer">
                            <MudButton Variant="Variant.Text" OnClick="ToggleCorrection">Cancel</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CorrectConnectionAsync" Disabled="_busy">Save the IDs</MudButton>
                        </div>
                    </div>
                }
            </Section>
        </MudTabPanel>

        @if (_deletion is not null && (_canHold || _canDelete))
        {
            <MudTabPanel Text="Legal hold and deletion">
                <Section Title="Legal hold" Description="@LegalHoldDescription">
                    @if (_canHold)
                    {
                        <MudSwitch T="bool" Value="@_deletion.LegalHold" ValueChanged="SetTenantHoldAsync" Color="Color.Warning"
                                   Label="Legal hold for the whole tenant: no snapshot expires until the hold is released" />
                    }
                    else
                    {
                        <p class="mt-0">@(_deletion.LegalHold ? "This tenant is on legal hold: no snapshot expires until the hold is released." : "This tenant is not on legal hold.")</p>
                    }
                </Section>
                @if (_canDelete)
                {
                    <Section Title="Delete the tenant" Class="vy-danger">
                        @if (!_deletion.HoldsBackups && _deletion.State != "deleted")
                        {
                            <p class="mt-0">This tenant holds no backups yet, so nothing needs protecting: you can remove it now, for example to connect it again with the right details.
                                As soon as it holds a backup, deleting it takes a request, 30 days and a second administrator.</p>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="RemoveUnusedAsync" Disabled="@(_busy || _deletion.LegalHold)">Remove tenant now</MudButton>
                        }
                        else
                        {
                            @switch (_deletion.State)
                            {
                                case "active":
                                    <p class="mt-0">Deleting a tenant stops its backups at once. A second administrator can confirm the deletion after 30 days;
                                        until then it can be withdrawn. After confirmation the data is removed as its retention lock expires.</p>
                                    @if (_deletion.LegalHold)
                                    {
                                        <p class="vy-muted">Release the legal hold first; a tenant on legal hold cannot be deleted.</p>
                                    }
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RequestDeletionAsync" Disabled="@(_busy || _deletion.LegalHold)">Request deletion</MudButton>
                                    break;
                                case "deletion_requested":
                                    <Notice Tone="warning" Title="Deletion requested">
                                        Requested on @Time.Absolute(_deletion.RequestedAt). Backups are stopped. A second administrator can confirm from @Time.Absolute(_deletion.ConfirmableFrom).
                                    </Notice>
                                    <div class="d-flex gap-2">
                                        <MudButton Variant="Variant.Outlined" OnClick="WithdrawDeletionAsync" Disabled="_busy">Withdraw the request</MudButton>
                                        @if (_deletion.RequestedBy != _userId)
                                        {
                                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeletionAsync"
                                                       Disabled="@(_busy || Clock.GetUtcNow() < _deletion.ConfirmableFrom)">Confirm deletion</MudButton>
                                        }
                                        else
                                        {
                                            <span class="vy-muted align-self-center">Another administrator confirms; you requested it.</span>
                                        }
                                    </div>
                                    break;
                                default:
                                    <p class="mt-0">This tenant is deleted. Its data is removed as its retention lock expires.</p>
                                    break;
                            }
                        }
                    </Section>
                }
            </MudTabPanel>
        }
    </MudTabs>
}

@code {
    private const int TabConnection = 2;

    [Parameter] public Guid TenantId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }
    [SupplyParameterFromQuery(Name = "connected")] public int? Connected { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthenticationState { get; set; } = default!;

    private TenantRow? _tenant;
    private IReadOnlyList<ProtectedObjectRow> _objects = [];
    private PermissionProbeReport? _report;
    private string? _rotationScript;
    private bool _setupReady;
    private bool _repairWithRestore = true;
    [SupplyParameterFromQuery(Name = "run")] public Guid? RunQuery { get; set; }
    [SupplyParameterFromQuery(Name = "go")] public string? GoQuery { get; set; }
    [SupplyParameterFromQuery(Name = "restore")] public int? RestoreQuery { get; set; }
    private bool _resumed;
    private bool _canConnect;
    private bool _canRun;
    private IReadOnlyList<string> _columns = Vaulty.Core.Dashboards.ColumnCatalog.Default(Vaulty.Core.Dashboards.ColumnCatalog.Objects);
    private bool _canBrowse;
    private bool _canManagePolicy;
    private bool _canChangeRetention;
    private bool _canHold;
    private bool _canDelete;
    private TenantDeletionState? _deletion;
    private bool _protectNew;
    private bool _correcting;
    private string? _correctTenantId;
    private string? _correctClientId;
    private TenantStatusRow? _health;
    private IReadOnlySet<Guid> _held = new HashSet<Guid>();
    private int _frequencyHours = 6;
    private int _retentionDays = 90;
    private int _savedRetentionDays = 90;
    private string? _excluded;
    private bool _busy;
    private int _tab;
    private Guid _organizationId;
    private Guid _userId;

    private bool Granted => _tenant?.ConsentState == "granted";

    private static readonly int[] FrequencyHours = [1, 2, 4, 6, 8, 12, 24];
    private static readonly int[] RetentionDays = [90, 180, 365, 730, 1095, 1825, 2555, 3650];

    private IEnumerable<int> FrequencyOptions => FrequencyHours.Contains(_frequencyHours) ? FrequencyHours : FrequencyHours.Append(_frequencyHours).Order();
    private IEnumerable<int> RetentionOptions => RetentionDays.Contains(_retentionDays) ? RetentionDays : RetentionDays.Append(_retentionDays).Order();

    private static string FrequencyLabel(int hours) => hours switch { 1 => "Every hour", 24 => "Once a day", _ => $"Every {hours} hours" };

    private static string RetentionLabel(int days) => days switch
    {
        _ when days % 365 == 0 => days == 365 ? "1 year" : $"{days / 365} years",
        _ => $"{days} days",
    };

    private string PolicyDescription => $"Backed up {FrequencyLabel(_frequencyHours).ToLowerInvariant()}, kept {RetentionLabel(_savedRetentionDays)}. Changes apply from the next backup.";

    private const string ConnectionDescription = "Vaulty signs in to the tenant with its own app registration and a certificate whose private key only Vaulty holds.";

    private const string LegalHoldDescription = "A hold suspends retention: no snapshot of the tenant or of a held protected object expires until the hold is released. Place a hold on one protected object from its row menu.";

    private string HealthDetail
    {
        get
        {
            try
            {
                using var doc = JsonDocument.Parse(_tenant!.Health);
                return doc.RootElement.TryGetProperty("detail", out var d) ? d.GetString() ?? "" : "";
            }
            catch (JsonException)
            {
                return "";
            }
        }
    }

    private static string KindLabel(ProtectedObjectRow row) => Vaulty.Web.Browse.ObjectLabels.Kind(row.Kind, row.SubKind);

    private static string? Upn(ProtectedObjectRow row)
    {
        try
        {
            using var doc = JsonDocument.Parse(row.SourceDetails);
            return doc.RootElement.ValueKind == JsonValueKind.Object && doc.RootElement.TryGetProperty("upn", out var upn) && upn.ValueKind == JsonValueKind.String
                ? upn.GetString() : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    private bool _loaded;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            await LoadAsync();
            _tab = TabQuery switch { "policy" => 1, "connection" => TabConnection, "hold" => 3, _ => _tab };
        }
        finally
        {
            _loaded = true;
        }
    }

    private void SelectTab(int tab) => _tab = tab;

    private async Task LoadAsync()
    {
        var user = (await AuthenticationState).User;
        _organizationId = VaultyWebSetup.OrganizationId(user) ?? Guid.Empty;
        _userId = VaultyWebSetup.UserId(user) ?? Guid.Empty;
        var tenant = (await TenantService.ListAsync(_organizationId)).FirstOrDefault(t => t.Id == TenantId);
        var access = await Current.GetAsync(user);
        if (tenant is null || !access.AllowsTenant(Permissions.CustomersView, tenant.CustomerId, tenant.Id)) return;
        _tenant = tenant;
        _canConnect = access.AllowsTenant(Permissions.TenantsConnect, tenant.CustomerId, tenant.Id);
        _setupReady = _canConnect && (await SetupApp.GetAsync()).Ready;
        if (!_resumed && RestoreQuery is { } restore) _repairWithRestore = restore != 0;
        else if (!_resumed) _repairWithRestore = HasRestorePermissions(tenant.GrantedPermissions) || tenant.ConsentState != "granted";
        _canRun = access.AllowsTenant(Permissions.BackupsRun, tenant.CustomerId, tenant.Id);
        _canBrowse = access.AllowsTenant(Permissions.SnapshotsBrowse, tenant.CustomerId, tenant.Id);
        _canManagePolicy = access.AllowsTenant(Permissions.PoliciesManage, tenant.CustomerId, tenant.Id);
        _canChangeRetention = access.AllowsTenant(Permissions.RetentionManage, tenant.CustomerId, tenant.Id);
        _canHold = access.AllowsTenant(Permissions.LegalHoldManage, tenant.CustomerId, tenant.Id);
        _canDelete = access.AllowsTenant(Permissions.TenantsDelete, tenant.CustomerId, tenant.Id);
        _columns = await ColumnLayouts.ForUserAsync(access, Vaulty.Core.Dashboards.ColumnCatalog.Objects);
        _objects = await TenantService.ProtectedObjectsAsync(_organizationId, TenantId);
        _deletion = await Deletion.StateAsync(access, TenantId);
        _protectNew = await Selection.ProtectsNewObjectsAsync(access, TenantId);
        await Time.LoadAsync();
        _health = (await Dashboards.LoadAsync(access, TenantId)).Tenants.FirstOrDefault(t => t.Id == TenantId);
        _held = await Holds.ObjectsOnHoldAsync(access, TenantId);
        var policy = await TenantService.PolicyAsync(_organizationId, TenantId);
        (_frequencyHours, _retentionDays, _excluded) = (Math.Max(1, policy.FrequencyMinutes / 60), policy.RetentionDays, string.Join(", ", policy.ExcludedFolders));
        _savedRetentionDays = policy.RetentionDays;
    }

    private async Task<bool> ConfirmedAsync()
    {
        if (VaultyWebSetup.HasFreshStepUp((await AuthenticationState).User, Clock)) return true;
        var tab = _tab switch { 1 => "policy", TabConnection => "connection", 3 => "hold", _ => null };
        Navigation.NavigateTo($"/account/confirm?returnUrl={Uri.EscapeDataString($"/tenants/{TenantId}{(tab is null ? "" : $"?tab={tab}")}")}", forceLoad: true);
        return false;
    }

    private async Task<bool> NeedsStepUpAsync() => !VaultyWebSetup.HasFreshStepUp((await AuthenticationState).User, Clock);

    private async Task ProbeAsync()
    {
        _busy = true;
        try
        {
            _report = await TenantService.ProbeAsync(_organizationId, _userId, TenantId);
            if (!_report.BackupReady) Snackbar.Add("Microsoft can take a few minutes before a new app works. Check again shortly.", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is Microsoft.Identity.Client.MsalException or InvalidOperationException or HttpRequestException)
        {
            Snackbar.Add($"The app could not sign in yet: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DiscoverAsync()
    {
        _busy = true;
        try
        {
            await Workflows.StartDiscoveryAsync(_organizationId, TenantId, _userId);
            Snackbar.Add("Discovery started. The list fills in when it finishes; follow it on the Jobs page.", Severity.Success);
        }
        catch (Exception ex) when (ex is InvalidOperationException or Temporalio.Exceptions.TemporalException)
        {
            Snackbar.Add($"Discovery could not start: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SavePolicyAsync()
    {
        var current = await TenantService.PolicyAsync(_organizationId, TenantId);
        if (current.RetentionDays != _retentionDays && !_canChangeRetention) return;
        if (_retentionDays < current.RetentionDays)
        {
            var ok = await Dialogs.ConfirmAsync("Shorten the retention?",
                $"Snapshots are then kept {RetentionLabel(_retentionDays)} instead of {RetentionLabel(current.RetentionDays)}. Snapshots older than that expire and their data is removed once its lock ends; this cannot be undone.",
                "Shorten the retention", danger: true, stepUp: await NeedsStepUpAsync());
            if (!ok) return;
        }
        if (current.RetentionDays != _retentionDays && !await ConfirmedAsync()) return;
        try
        {
            await TenantService.SavePolicyAsync(_organizationId, _userId, TenantId, new TenantService.PolicyView(_frequencyHours * 60, _retentionDays,
                (_excluded ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)));
            _savedRetentionDays = _retentionDays;
            Snackbar.Add("Policy saved. It applies from the next backup.", Severity.Success);
        }
        catch (TenantException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task SetObjectHoldAsync(ProtectedObjectRow row, bool hold)
    {
        if (!hold && !await Dialogs.ConfirmAsync($"Release the legal hold on {row.DisplayName}?",
                "Retention runs again: snapshots older than the retention expire and their data is removed once its lock ends.", "Release hold", danger: true))
        {
            return;
        }
        await Holds.SetForObjectAsync(await Current.GetAsync(), row.Id, hold);
        Snackbar.Add(hold ? $"Legal hold placed on {row.DisplayName}." : $"Legal hold on {row.DisplayName} released.", Severity.Info);
        await LoadAsync();
    }

    private async Task SetTenantHoldAsync(bool hold)
    {
        if (!hold && !await Dialogs.ConfirmAsync("Release the legal hold on the tenant?",
                "Retention runs again for every protected object without its own hold: snapshots older than the retention expire and their data is removed once its lock ends.",
                "Release hold", danger: true))
        {
            return;
        }
        await Holds.SetForTenantAsync(await Current.GetAsync(), TenantId, hold);
        Snackbar.Add(hold ? "Legal hold placed on the tenant." : "Legal hold on the tenant released.", Severity.Info);
        await LoadAsync();
    }

    private async Task RequestDeletionAsync()
    {
        if (!await Dialogs.ConfirmAsync($"Request deletion of {_tenant!.DisplayName}?",
                "Backups stop at once. A second administrator can confirm the deletion after 30 days; until then you can withdraw it.", "Request deletion",
                danger: true, stepUp: await NeedsStepUpAsync(), typeToConfirm: _tenant.DisplayName))
        {
            return;
        }
        await DeletionStepAsync(async (access, fresh) => await Deletion.RequestAsync(access, fresh, TenantId),
            "Deletion requested. Backups are stopped; a second administrator can confirm in 30 days.");
    }

    private string SelectionSummary
    {
        get
        {
            var selected = _objects.Count(o => o.State is "active" or "paused");
            var excluded = _objects.Count(o => o.State == "excluded");
            return $"{selected} selected for backup, {excluded} excluded.";
        }
    }

    private string CountText
    {
        get
        {
            var shown = Filtered.Count();
            return shown == _objects.Count ? StatusText.Plural(_objects.Count, "protected object") : $"{shown} of {StatusText.Plural(_objects.Count, "protected object")}";
        }
    }

    private List<Guid> Selectable() => Filtered.Where(o => o.State is "active" or "excluded" or "paused").Select(o => o.Id).ToList();

    private static readonly string[] TypeFilters = ["Mailbox", "Shared mailbox", "Resource mailbox", "Archive mailbox", "OneDrive"];
    private static readonly string[] StatusFilters = ["Protected", "Partial", "Failed", "Awaiting first backup", "Excluded", "Source deleted", "Not protected yet", "Paused"];
    private string? _filterText;
    private string? _filterType;
    private string? _filterStatus;

    private void ClearFilters() => (_filterText, _filterType, _filterStatus) = (null, null, null);

    private IEnumerable<ProtectedObjectRow> Filtered => _objects.Where(o =>
        (string.IsNullOrWhiteSpace(_filterText) || o.DisplayName.Contains(_filterText.Trim(), StringComparison.OrdinalIgnoreCase)
            || o.SourceId.Contains(_filterText.Trim(), StringComparison.OrdinalIgnoreCase)
            || (Upn(o)?.Contains(_filterText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        && (_filterType is null || KindLabel(o) == _filterType)
        && (_filterStatus is null || StatusLabel(o) == _filterStatus));

    /// <summary>The status the table shows for an object, as text, so the status filter matches what is on screen.</summary>
    private string StatusLabel(ProtectedObjectRow o) => o.State switch
    {
        "source_deleted" => "Source deleted",
        "not_protected" => "Not protected yet",
        "paused" => "Paused",
        "excluded" => "Excluded",
        _ => _health?.Objects.FirstOrDefault(h => h.Id == o.Id) is { } status ? Protection.Label(status.Status) : "Awaiting first backup",
    };

    private int StatusRank(ProtectedObjectRow o) => StatusLabel(o) switch
    {
        "Failed" => 7, "Partial" => 6, "Awaiting first backup" => 5, "Not protected yet" => 4, "Paused" => 3, "Protected" => 2, "Source deleted" => 1, _ => 0,
    };

    private async Task SetSelectionAsync(List<Guid> ids, bool include)
    {
        if (!include && ids.Count > 0)
        {
            var name = ids.Count == 1 ? _objects.FirstOrDefault(o => o.Id == ids[0])?.DisplayName : null;
            var confirmed = await Dialogs.ConfirmAsync(name is null ? $"Exclude {ids.Count} protected objects from backup?" : $"Exclude {name} from backup?",
                "Running backups stop now and no new backups are made. The snapshots end with their retention and the data is then removed; selecting them again before then keeps everything.",
                "Exclude", danger: true, stepUp: await NeedsStepUpAsync(), cancelText: "Keep backing up");
            if (!confirmed) return;
        }
        await SelectionStepAsync(async (access, fresh) =>
        {
            var changed = await Selection.SetAsync(access, fresh, TenantId, ids, include);
            var stopped = 0;
            if (!include && changed > 0)
            {
                // Excluding stops a backup that is still running, so no more bandwidth goes to an object that is not backed up.
                foreach (var (workflowId, runId) in await Selection.RunningBackupsToStopAsync(access, TenantId, ids))
                {
                    // A run the request does not reach is stopped by the job reconciler, which acts on the recorded request.
                    if (await Workflows.CancelAsync(workflowId, runId)) stopped++;
                }
            }
            Snackbar.Add(changed == 0 ? "Nothing to change." : include ? $"{changed} selected for backup; their first backup starts shortly."
                : $"{changed} excluded from backup{(stopped > 0 ? $"; {stopped} running {(stopped == 1 ? "backup was" : "backups were")} stopped" : "")}. " +
                  "Their data is removed once retention and its lock end, unless you select them again.",
                changed == 0 ? Severity.Info : Severity.Success);
        });
    }

    private async Task SetProtectNewAsync(bool protectNew) => await SelectionStepAsync(async (access, fresh) =>
    {
        await Selection.SetProtectNewObjectsAsync(access, fresh, TenantId, protectNew);
        Snackbar.Add(protectNew ? "Newly found mailboxes and OneDrives are backed up at once." : "Newly found mailboxes and OneDrives wait to be selected.",
            Severity.Success);
    });

    private async Task SelectionStepAsync(Func<Vaulty.Infrastructure.Access.UserAccess, bool, Task> step)
    {
        var user = (await AuthenticationState).User;
        _busy = true;
        try
        {
            await step(await Current.GetAsync(user), VaultyWebSetup.HasFreshStepUp(user, Clock));
            await LoadAsync();
        }
        catch (Vaulty.Infrastructure.Restore.StepUpRequiredException)
        {
            // Lowering protection asks "Confirm it's you" first; the change is made again after confirming.
            await ConfirmedAsync();
        }
        catch (Vaulty.Infrastructure.Access.AccessException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveUnusedAsync()
    {
        if (!await Dialogs.ConfirmAsync($"Remove {_tenant!.DisplayName} now?",
                "The tenant holds no backups, so nothing is lost. Its connection and certificate are removed; you can connect it again afterwards.", "Remove tenant",
                danger: true, stepUp: await NeedsStepUpAsync()))
        {
            return;
        }
        var customerId = _tenant!.CustomerId;
        await DeletionStepAsync(async (access, fresh) => await Deletion.RemoveUnusedAsync(access, fresh, TenantId), "The tenant is removed. You can connect it again.");
        if ((await TenantService.ListAsync(_organizationId)).All(t => t.Id != TenantId)) Navigation.NavigateTo($"/customers/{customerId}");
    }

    private void ToggleCorrection()
    {
        _correcting = !_correcting;
        _correctTenantId = _tenant?.EntraTenantId.ToString();
        _correctClientId = _tenant?.ClientId?.ToString();
    }

    private async Task CorrectConnectionAsync()
    {
        if (!Guid.TryParse(_correctTenantId?.Trim(), out var entraTenantId) || !Guid.TryParse(_correctClientId?.Trim(), out var clientId))
        {
            Snackbar.Add("Enter the tenant ID and the application ID as they appear in Entra (a GUID such as 00000000-0000-0000-0000-000000000000).", Severity.Warning);
            return;
        }
        if (!await ConfirmedAsync()) return;
        _busy = true;
        try
        {
            await TenantService.CorrectConnectionAsync(_organizationId, _userId, TenantId, entraTenantId, clientId);
            _correcting = false;
            Snackbar.Add("Connection details saved. Run the permission check.", Severity.Success);
            await LoadAsync();
        }
        catch (TenantException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task WithdrawDeletionAsync() => await DeletionStepAsync(async (access, _) => await Deletion.WithdrawAsync(access, TenantId),
        "The deletion request is withdrawn. Backups resume.");

    private async Task ConfirmDeletionAsync()
    {
        if (!await Dialogs.ConfirmAsync($"Delete {_tenant!.DisplayName}?",
                "The tenant is deleted. Its data is removed as its retention lock expires; this cannot be undone.", "Delete the tenant",
                danger: true, stepUp: await NeedsStepUpAsync(), typeToConfirm: _tenant.DisplayName))
        {
            return;
        }
        await DeletionStepAsync(async (access, fresh) => await Deletion.ConfirmAsync(access, fresh, TenantId), "The tenant is deleted.");
    }

    private async Task DeletionStepAsync(Func<Vaulty.Infrastructure.Access.UserAccess, bool, Task> step, string done)
    {
        var user = (await AuthenticationState).User;
        _busy = true;
        try
        {
            await step(await Current.GetAsync(user), VaultyWebSetup.HasFreshStepUp(user, Clock));
            Snackbar.Add(done, Severity.Success);
            await LoadAsync();
        }
        catch (Vaulty.Infrastructure.Restore.StepUpRequiredException)
        {
            await ConfirmedAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or Vaulty.Infrastructure.Access.AccessException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BackUpNowAsync(ProtectedObjectRow row)
    {
        try
        {
            var job = await Workflows.StartBackupAsync(_organizationId, TenantId, row.Id, row.Kind, _userId);
            Snackbar.Add(job is null ? $"A backup of {row.DisplayName} is already running." : $"Backup of {row.DisplayName} started. Follow it on the Jobs page.", Severity.Info);
        }
        catch (Exception ex) when (ex is InvalidOperationException or Temporalio.Exceptions.TemporalException)
        {
            Snackbar.Add($"The backup could not start: {ex.Message}", Severity.Error);
        }
    }

    private async Task BeginRotationAsync()
    {
        if (!await ConfirmedAsync()) return;
        if (_tenant?.SelfRotation != true)
        {
            _rotationScript = await TenantService.BeginRotationAsync(_organizationId, _userId, TenantId);
            await LoadAsync();
            return;
        }
        _busy = true;
        try
        {
            var outcome = await Rotation.RotateAsync(_organizationId, $"user:{_userId}", TenantId);
            _rotationScript = outcome.FallbackScript;
            Snackbar.Add(outcome.Message, outcome.Rotated ? Severity.Success : Severity.Warning);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is TenantException or InvalidOperationException or Microsoft.Identity.Client.MsalException)
        {
            Snackbar.Add($"The certificate was not rotated: {ex.Message}", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool HasRestorePermissions(string grantedJson)
    {
        try
        {
            var granted = JsonSerializer.Deserialize<string[]>(grantedJson) ?? [];
            return GraphPermissions.All.Where(p => p.ForRestore).Any(p => granted.Contains(p.Name));
        }
        catch (JsonException)
        {
            return false;
        }
    }

    /// <summary>An administrator of the tenant signs in; Vaulty repairs the app registration, its certificate and its permissions.</summary>
    private async Task RepairAsync()
    {
        if (!_canConnect || !_setupReady) return;
        if (!VaultyWebSetup.HasFreshStepUp((await AuthenticationState).User, Clock))
        {
            Navigation.NavigateTo($"/account/confirm?returnUrl={Uri.EscapeDataString($"/tenants/{TenantId}?tab=connection&go=repair&restore={(_repairWithRestore ? 1 : 0)}")}", forceLoad: true);
            return;
        }
        _busy = true;
        try
        {
            var redirect = SetupAppService.RedirectUri(HostOptions.PublicHost, new Uri(Navigation.BaseUri));
            var url = await Connection.BeginAsync(SignInPurpose.Repair, _organizationId, _userId, TenantId, redirect, $"/tenants/{TenantId}?tab=connection",
                _repairWithRestore, _tenant?.EntraTenantId.ToString(), consent: true);
            Navigation.NavigateTo(url.ToString(), forceLoad: true);
        }
        catch (TenantException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
            _busy = false;
        }
    }

    private async Task RepairFinishedAsync(SetupRunView view)
    {
        await LoadAsync();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Back from "Confirm it's you" with a repair asked for: continue with it.
        if (!firstRender || !RendererInfo.IsInteractive || _resumed || GoQuery != "repair" || _tenant is null) return;
        _resumed = true;
        if (VaultyWebSetup.HasFreshStepUp((await AuthenticationState).User, Clock)) await RepairAsync();
    }

    private async Task CompleteRotationAsync()
    {
        if (!await ConfirmedAsync()) return;
        _busy = true;
        try
        {
            await TenantService.CompleteRotationAsync(_organizationId, _userId, TenantId);
            _rotationScript = null;
            Snackbar.Add("The new certificate works and is now in use. Remove the old certificate from the app registration.", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) when (ex is Microsoft.Identity.Client.MsalException or InvalidOperationException)
        {
            Snackbar.Add($"The new certificate does not work yet: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }
}
