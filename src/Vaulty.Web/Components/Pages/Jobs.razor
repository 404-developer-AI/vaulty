@page "/jobs"
@attribute [Authorize(Policy = "perm:" + Permissions.JobsView)]
@using Vaulty.Infrastructure.Notifications
@using Vaulty.Infrastructure.Tenants
@using Vaulty.Workflows.Tenants
@implements IAsyncDisposable
@inject JobsService JobsService
@inject TenantService Tenants
@inject IWorkflowStarter Workflows
@inject CurrentAccess Current
@inject DisplayTime Time
@inject TimeProvider Clock
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>Jobs · Vaulty</PageTitle>

<PageHeader Title="Jobs" Lede="Every discovery, backup, restore, export, verification and clean-up, newest first. Running jobs update by themselves. Quote the request ID when you contact support." />

<Section Flush="true">
    <div class="vy-table-toolbar" style="padding: 4px 20px 0">
        <div class="vy-table-search">
            <MudTextField T="string" @bind-Value="_search" Placeholder="Object, tenant or request ID" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                          OnBlur="@(() => LoadAsync(reset: true))" OnKeyUp="@(async e => { if (e.Key == "Enter") await LoadAsync(reset: true); })"
                          OnClearButtonClick="@(() => LoadAsync(reset: true))" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" aria-label="Search jobs" />
        </div>
        <div class="vy-table-filter">
            <MudSelect T="Guid?" Label="Tenant" Value="_tenant" ValueChanged="@(async v => { _tenant = v; await LoadAsync(reset: true); })" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense" ToStringFunc="@(id => _tenants.FirstOrDefault(t => t.Id == id)?.DisplayName ?? "")">
                @foreach (var t in _tenants) { <MudSelectItem T="Guid?" Value="@t.Id">@t.DisplayName</MudSelectItem> }
            </MudSelect>
        </div>
        <div class="vy-table-filter">
            <MudSelect T="string" Label="Status" Value="_state" ValueChanged="@(async v => { _state = v; await LoadAsync(reset: true); })" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var s in States) { <MudSelectItem Value="@s">@StatusText.JobLabel(s)</MudSelectItem> }
            </MudSelect>
        </div>
        <div class="vy-table-filter">
            <MudSelect T="string" Label="Type" Value="_kind" ValueChanged="@(async v => { _kind = v; await LoadAsync(reset: true); })" Clearable="true"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var k in Kinds) { <MudSelectItem Value="@k">@StatusText.JobKind(k)</MudSelectItem> }
            </MudSelect>
        </div>
        @if (Filtered)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearAsync">Clear filters</MudButton>
        }
    </div>

    @if (_error is not null)
    {
        <div style="padding: 0 20px"><Notice Tone="error" Title="The jobs could not be loaded" OnRetry="@(() => LoadAsync(reset: true))">@_error</Notice></div>
    }

    <MudTable Items="_jobs" Dense="true" Hover="true" Elevation="0" Loading="_loading" LoadingProgressColor="Color.Primary" Breakpoint="Breakpoint.None" HorizontalScrollbar="true">
        <HeaderContent>
            <MudTh>Type</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Target</MudTh>
            <MudTh>Started</MudTh>
            <MudTh>Finished</MudTh>
            <MudTh>Result</MudTh>
            <MudTh>Request ID</MudTh>
            <MudTh><span class="vy-sr-only">Actions</span></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@StatusText.JobKind(context.Kind)</MudTd>
            <MudTd><span class="vy-status @StatusText.JobTone(context.State)">@StatusText.JobLabel(context.State)</span></MudTd>
            <MudTd>
                @if (context.ObjectId is { } objectId && context.ObjectName is not null)
                {
                    <a href="@($"/objects/{objectId}")">@context.ObjectName</a>
                    @if (context.TenantName is not null)
                    {
                        <div class="vy-cell-sub">@context.TenantName</div>
                    }
                }
                else if (context.TenantId is { } tenantId && context.TenantName is not null)
                {
                    <a href="@($"/tenants/{tenantId}")">@context.TenantName</a>
                }
            </MudTd>
            <MudTd Class="vy-nowrap">@Time.Relative(context.StartedAt ?? context.CreatedAt)</MudTd>
            <MudTd Class="vy-nowrap">@Time.Relative(context.FinishedAt)</MudTd>
            <MudTd Style="min-width: 320px">
                @if (context.State == "running" && context.Kind == "backup")
                {
                    var now = Clock.GetUtcNow();
                    var progress = context.Progress(now);
                    <div class="vy-progress">
                        @if (progress is { } p)
                        {
                            <div class="vy-progress-bar">
                                <MudProgressLinear Value="@(p.Fraction * 100)" Color="Color.Primary" Rounded="true" Size="Size.Large" aria-label="Progress" />
                                <strong class="vy-progress-percent">@((int)(p.Fraction * 100))%</strong>
                            </div>
                            <div>@DoneText(context)</div>
                            <div class="vy-muted">
                                @if (p.Remaining is { } left)
                                {
                                    <text>@(left.TotalMinutes < 1 ? "Less than a minute" : $"About {Duration(left)}") left · done around @Time.Ahead(now + left)</text>
                                }
                                else
                                {
                                    <text>Estimating the time left…</text>
                                }
                            </div>
                        }
                        else
                        {
                            @* An incremental run learns its changes as it goes, and a run started before sizes were recorded has none:
                               there is no total to measure against, so no guess. *@
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Rounded="true" Size="Size.Medium" aria-label="Progress" />
                            <div>@ItemsText(context.ItemsSoFar ?? 0) items processed@(context.BytesSoFar is > 0 ? $" · {Bytes(context.BytesSoFar.Value)}" : "")</div>
                            <div class="vy-muted">Total not known for this run, so no time estimate.</div>
                        }
                    </div>
                }
                @Counts(context.ResultCounts)
                @if (!string.IsNullOrEmpty(context.Error))
                {
                    <div class="vy-state-reason" style="color: var(--vy-error-text)">@context.Error</div>
                }
            </MudTd>
            <MudTd><code class="vy-request-id" title="@context.WorkflowId">@context.Id</code></MudTd>
            <MudTd Class="vy-actions-cell">
                @if (context.Kind is "restore" or "export" && context.ObjectId is not null)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/objects/{context.ObjectId}")">Report</MudButton>
                }
                @if (context.Kind is "backup" or "discovery" && context.State is "queued" or "running")
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="_busy" OnClick="@(() => CancelAsync(context))">Cancel</MudButton>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            @if (Filtered)
            {
                <EmptyState Title="No jobs match the filters" Icon="@Icons.Material.Outlined.SearchOff" Compact="true">
                    <Actions><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="ClearAsync">Clear filters</MudButton></Actions>
                </EmptyState>
            }
            else
            {
                <EmptyState Title="No jobs yet" Icon="@Icons.Material.Outlined.History" Compact="true">Jobs appear here as soon as a tenant is connected and its first discovery starts.</EmptyState>
            }
        </NoRecordsContent>
    </MudTable>
    @if (_jobs.Count >= JobsService.PageSize)
    {
        <div class="pa-3"><MudButton Variant="Variant.Text" OnClick="@(() => LoadAsync(reset: false))">Older jobs</MudButton></div>
    }
</Section>

@code {
    private static readonly string[] States = ["queued", "running", "succeeded", "partial", "failed", "cancelled"];
    private static readonly string[] Kinds = ["discovery", "backup", "restore", "export", "verification", "garbage_collection"];

    [SupplyParameterFromQuery(Name = "kind")] public string? KindQuery { get; set; }
    [SupplyParameterFromQuery(Name = "state")] public string? StateQuery { get; set; }

    private List<JobRow> _jobs = [];
    private IReadOnlyList<TenantRow> _tenants = [];
    private string? _state;
    private string? _kind;
    private string? _search;
    private Guid? _tenant;
    private bool _busy;
    private bool _loading = true;
    private string? _error;
    private PeriodicTimer? _refresh;
    private Task? _refreshing;

    private bool Filtered => _state is not null || _kind is not null || _tenant is not null || !string.IsNullOrWhiteSpace(_search);

    protected override async Task OnInitializedAsync()
    {
        await Time.LoadAsync();
        if (KindQuery is not null && Kinds.Contains(KindQuery)) _kind = KindQuery;
        if (StateQuery is not null && States.Contains(StateQuery)) _state = StateQuery;
        var access = await Current.GetAsync();
        _tenants = (await Tenants.ListAsync(access.OrganizationId)).Where(t => access.AllowsTenant(Permissions.CustomersView, t.CustomerId, t.Id))
            .OrderBy(t => t.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
        await LoadAsync(reset: true);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // While the page is open, running jobs move: the first page is refreshed every 15 seconds.
        if (!firstRender || !RendererInfo.IsInteractive) return;
        _refresh = new PeriodicTimer(TimeSpan.FromSeconds(15));
        _refreshing = RefreshAsync(_refresh);
    }

    private async Task RefreshAsync(PeriodicTimer timer)
    {
        while (await timer.WaitForNextTickAsync())
        {
            if (_jobs.Count > JobsService.PageSize || !_jobs.Any(j => j.State is "running" or "queued")) continue;
            await InvokeAsync(async () =>
            {
                await LoadAsync(reset: true);
                StateHasChanged();
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        _refresh?.Dispose();
        if (_refreshing is not null) await _refreshing;
    }

    private async Task ClearAsync()
    {
        (_state, _kind, _tenant, _search) = (null, null, null, null);
        await LoadAsync(reset: true);
    }

    private async Task LoadAsync(bool reset)
    {
        var before = reset || _jobs.Count == 0 ? (DateTimeOffset?)null : _jobs[^1].CreatedAt;
        try
        {
            var page = await JobsService.ListAsync(await Current.GetAsync(), _state, _kind, before, _search, _tenant);
            _jobs = reset ? page.ToList() : [.. _jobs, .. page];
            _error = null;
        }
        catch (Exception ex) when (ex is Npgsql.NpgsqlException or TimeoutException)
        {
            _error = "Vaulty could not read the jobs from its database. Try again in a moment.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CancelAsync(JobRow job)
    {
        var confirmed = await Dialogs.ConfirmAsync("Cancel this job?",
            $"The {StatusText.JobKind(job.Kind).ToLowerInvariant()} of {job.ObjectName ?? job.TenantName} stops. Nothing already stored is lost, and its next planned run starts as usual.",
            "Cancel the job", danger: true, cancelText: "Keep it running");
        if (!confirmed) return;
        _busy = true;
        try
        {
            var reached = await JobsService.CancelAsync(await Current.GetAsync(), job.Id) is not { } run || await Workflows.CancelAsync(run.WorkflowId, run.RunId);
            Snackbar.Add(reached ? "Cancellation requested. The job ends after its current step."
                : "The request did not reach this job's run. Vaulty stops or closes the job within a few minutes.", Severity.Info);
            await LoadAsync(reset: true);
        }
        catch (Exception ex) when (ex is Vaulty.Infrastructure.Access.AccessException or InvalidOperationException)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ItemsText(long count) => count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture);

    // A drive is measured in bytes (its file count is not known up front); a mailbox in items.
    private static string DoneText(JobRow job) => job.ExpectedBytes is > 0
        ? $"{Bytes(job.BytesSoFar ?? 0)} / {Bytes(job.ExpectedBytes.Value)} processed · {ItemsText(job.ItemsSoFar ?? 0)} files"
        : $"{ItemsText(job.ItemsSoFar ?? 0)} / {ItemsText(job.ExpectedItems ?? 0)} items processed";

    private static string Duration(TimeSpan span) => span.TotalMinutes < 1 ? "less than a minute"
        : span.TotalHours < 1 ? $"{(int)Math.Ceiling(span.TotalMinutes)} min"
        : span.TotalDays < 1 ? $"{(int)span.TotalHours} h {span.Minutes} min"
        : $"{(int)span.TotalDays} d {span.Hours} h";

    private static string Bytes(long bytes) => bytes switch
    {
        >= 1L << 30 => $"{bytes / (double)(1L << 30):0.0} GB",
        >= 1L << 20 => $"{bytes / (double)(1L << 20):0.0} MB",
        _ => $"{bytes / 1024.0:0} KB",
    };

    private static string Counts(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            return string.Join(", ", doc.RootElement.EnumerateObject().Where(p => p.Value.ValueKind == System.Text.Json.JsonValueKind.Number)
                .Select(p => $"{p.Value.GetInt64().ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} {p.Name.Replace('_', ' ')}"));
        }
        catch (System.Text.Json.JsonException)
        {
            return "";
        }
    }
}
